#!/usr/bin/env php
<?php

declare(strict_types=1);

// The Stage 1 runner (ADR-0013 section 3, ADR-0014 section 3); see Pront\Cli\Application.

// Composer 2.2+ sets $_composer_autoload_path in its bin proxy; the fallback is this repository's
// own checkout.
require $GLOBALS['_composer_autoload_path'] ?? dirname(__DIR__) . '/vendor/autoload.php';

exit((new Pront\Cli\Application())->run(array_slice($_SERVER['argv'], 1), STDOUT, STDERR));
