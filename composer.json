{
    "name": "rigortype/pront",
    "description": "Declarative property-based testing for PHP",
    "type": "library",
    "license": "MPL-2.0",
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "ext-tokenizer": "*",
        "nikic/php-parser": "^5.9",
        "phpstan/phpdoc-parser": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Pront\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pront\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/pront"
    ],
    "config": {
        "sort-packages": true
    }
}
